#!/usr/bin/env bash
# Daily headless SEO-brain tick. Schedule this; it needs no session and no Lou.
#
# It runs the two things a cron CAN do safely:
#   sync   — fetch API-backed due checks via the Semrush REST API (needs SEMRUSH_API_KEY)
#   assess — evaluate thresholds; exit 4 if any critical finding or gate drift
#
# It NEVER publishes, deploys, or touches the live site. The one thing it does
# send is a one-line run ping to Lou's Telegram (CONTRACT clause 5) — operator
# telemetry, not outreach. The session-only
# checks (aeo.*, live-HTML schema) are left for the fmd-seo-loop skill. GSC runs
# headlessly when its service-account key is configured and otherwise reports an
# explicit no-op. A non-zero assess exit is the signal that a session run is due.
set -euo pipefail

# A Task-Scheduler-launched shell is non-interactive and inherits a bare PATH;
# set it up so python3 (and any user-local bins) resolve. Matches the ingest
# wrapper's PATH setup.
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

# CDPATH= neutralizes a caller's CDPATH, which otherwise makes `cd` echo the
# target dir and doubles the command substitution.
ENGINE_ROOT="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ENGINE_ROOT"
export PYTHONPATH="$ENGINE_ROOT/src"

if [[ -f "$ENGINE_ROOT/DISABLED" ]]; then
  echo "fmd-seo-cron: kill switch engaged (DISABLED present) — skipping." >&2
  NOTIFY_OK_CODES="0" bash "$ENGINE_ROOT/bin/notify-run" \
    "FMD-SEO 🛑 KILLED" "4" "DISABLED present; no checks ran" || true
  exit 0
fi

log_dir="$ENGINE_ROOT/.run/cron"
mkdir -p "$log_dir"
stamp="$(date -u +%Y%m%dT%H%M%SZ)"

# An abort before the normal notify path (bad PATH, missing python, dead venv)
# is exactly the silent failure the ping exists to catch, so trap it too. The
# normal path ends in `exit`, which does not fire ERR — no double-send.
notify_abort() {
  local code=$?
  bash "$ENGINE_ROOT/bin/notify-run" "FMD-SEO" "$code" "aborted early — see $stamp.log" || true
}
trap notify_abort ERR

echo "== sync ($stamp) ==" | tee "$log_dir/$stamp.log"
if sync_out="$(python3 -m fmd_seo sync 2>&1)"; then
  sync_code=0
else
  sync_code=$?
fi
printf '%s\n' "$sync_out" | tee -a "$log_dir/$stamp.log"

echo "== gsc-sync ($stamp) ==" | tee -a "$log_dir/$stamp.log"
if gsc_out="$(python3 -m fmd_seo gsc-sync 2>&1)"; then
  gsc_code=0
else
  gsc_code=$?
fi
printf '%s\n' "$gsc_out" | tee -a "$log_dir/$stamp.log"

echo "== assess ($stamp) ==" | tee -a "$log_dir/$stamp.log"
# assess exit 4 = critical finding or gate drift; surface it as this script's exit
# without aborting the log write. Captured rather than streamed so the notify
# line can read the summary back without re-parsing the log.
if assess_out="$(python3 -m fmd_seo assess 2>&1)"; then
  assess_code=0
else
  assess_code=$?
fi
printf '%s\n' "$assess_out" | tee -a "$log_dir/$stamp.log"

overall_code=0
if (( sync_code == 5 || gsc_code == 5 || assess_code == 5 )); then
  overall_code=5
elif (( sync_code >= 4 || gsc_code >= 4 )); then
  overall_code=4
elif (( sync_code == 3 || gsc_code == 3 )); then
  overall_code=3
elif (( assess_code != 0 )); then
  overall_code=$assess_code
fi

echo "fmd-seo-cron: done (sync=$sync_code gsc=$gsc_code assess=$assess_code overall=$overall_code)" | tee -a "$log_dir/$stamp.log"

# One-line Telegram heartbeat. Assess exit 4 is healthy only when sync and GSC
# completed; a provider exit 4 must stay an error even if assess later surfaces
# the resulting critical finding with the same numeric code.
detail="$(printf '%s' "$assess_out" | python3 -c '
import json, sys
try:
    s = json.load(sys.stdin).get("summary", {})
except Exception:
    print("assess output unreadable")
    sys.exit(0)
bits = []
if s.get("critical"): bits.append(str(s["critical"]) + " crit")
if s.get("high"): bits.append(str(s["high"]) + " high")
if s.get("gate_drift"): bits.append("gate drift")
print(", ".join(bits) + " -> session due" if bits else "all clear")
' 2>/dev/null)" || detail=""

detail="sync=$sync_code gsc=$gsc_code assess=$assess_code; $detail"
ok_codes="0"
if (( sync_code == 0 && gsc_code == 0 && (assess_code == 0 || assess_code == 4) )); then
  ok_codes="0 4"
fi

# Invoked via `bash` rather than directly: the ping must not depend on an exec
# bit surviving a clone/checkout.
NOTIFY_OK_CODES="$ok_codes" bash "$ENGINE_ROOT/bin/notify-run" \
  "FMD-SEO" "$overall_code" "$detail" || true

exit "$overall_code"
